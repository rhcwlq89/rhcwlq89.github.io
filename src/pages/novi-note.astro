      /* ===== Final CTA (full gradient) ===== */
      .final-cta {
        position: relative;
        padding: 80px 40px;
        border-radius: 28px;
        overflow: hidden;
        text-align: center;
        background: linear-gradient(135deg, var(--accent), var(--accent-hi));
        color: #fff;
        box-shadow: 0 40px 100px -20px color-mix(in srgb, var(--accent) 40%, transparent);
