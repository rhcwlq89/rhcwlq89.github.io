    <script is:inline>
      (function () {
        const stored = localStorage.getItem("novi-theme");
        if (stored === "light") {
          document.documentElement.classList.remove("theme-dark");
          document.documentElement.classList.add("theme-light");
        }
        const toggle = document.getElementById("theme-toggle");
        if (!toggle) return;
        const sync = () => {
          const isLight = document.documentElement.classList.contains("theme-light");
          toggle.querySelectorAll("button").forEach((b) => {
            b.classList.toggle("active", b.dataset.mode === (isLight ? "light" : "dark"));
          });
        };
        sync();
        toggle.querySelectorAll("button").forEach((b) => {
          b.addEventListener("click", () => {
            const mode = b.dataset.mode;
            document.documentElement.classList.toggle("theme-light", mode === "light");
            document.documentElement.classList.toggle("theme-dark", mode !== "light");
            localStorage.setItem("novi-theme", mode);
            sync();
          });
        });
      })();
    </script>

    <script is:inline>
      (function () {
        const SCRIPT_KO = [
          { kind: "user", t: 350, text: "방금 회의 녹음한 거 받아쓰고 회의록으로 정리해줘." },
          { kind: "tool", t: 600, tool: "novi_list_recordings", args: '{ "since": "1h" }' },
          { kind: "tool_ret", t: 600, text: "1개 녹음 · 18분 32초" },
          { kind: "thinking", t: 700, text: "WhisperKit으로 받아쓰는 중…" },
          { kind: "tool", t: 600, tool: "novi_transcribe", args: '{ "id": "rec_2026-04-29_1430" }' },
          { kind: "tool_ret", t: 600, text: "2,847자 · ko-KR" },
          { kind: "thinking", t: 700, text: "스크립트 읽고 핵심만 추리는 중…" },
          { kind: "note_action", t: 700, action: "create", title: "Q2 로드맵 회의" },
          { kind: "note_block", t: 500, block: { kind: "h1", text: "Q2 로드맵 회의" } },
          { kind: "note_block", t: 320, block: { kind: "callout", text: "녹음 18:32 → WhisperKit 전사 → AI 요약" } },
          { kind: "note_block", t: 320, block: { kind: "h2", text: "주요 결정" } },
          { kind: "note_block", t: 280, block: { kind: "li", text: "Q2 우선순위: 결제 모듈 안정화 — 2주 단축" } },
          { kind: "note_block", t: 280, block: { kind: "li", text: "데이터 마이그레이션은 5월 둘째 주 진행" } },
          { kind: "note_block", t: 320, block: { kind: "h2", text: "액션 아이템" } },
          { kind: "note_block", t: 280, block: { kind: "todo", text: "결제 회귀 테스트 시나리오 정리 (호종)" } },
          { kind: "note_block", t: 280, block: { kind: "todo", text: "마이그레이션 롤백 플랜 초안 (예린)" } },
          { kind: "assistant", t: 500, text: "완료. **업무 / 회의록** 폴더에 **Q2 로드맵 회의** 문서를 만들었어요. 액션 아이템을 내일 데일리 노트로 옮길까요?" },
        ];
        const LABELS_KO = { idle: "대기 중…", writing: "쓰는 중", empty: "— 노트 없음 —" };

        const root = document.getElementById("mcp-demo");
        if (!root) return;
        const SCRIPT = SCRIPT_KO;
        const L = LABELS_KO;

        const chatPane = document.getElementById("chat-pane");
        const notePane = document.getElementById("note-pane");
        const noteCrumb = document.getElementById("note-crumb");
        const noteWriting = document.getElementById("note-writing");
        const playBtn = document.getElementById("mcp-play");
        const restartBtn = document.getElementById("mcp-restart");
        const progress = document.getElementById("mcp-progress");

        const PLAY_SVG = '<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M7 4l13 8-13 8V4z" /></svg>';
        const PAUSE_SVG = '<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16" rx="1" /><rect x="14" y="4" width="4" height="16" rx="1" /></svg>';
        const CLAUDE_MARK = '<span style="display:inline-flex;width:20px;height:20px;border-radius:5px;background:linear-gradient(135deg,#d97757,#c95a3a);align-items:center;justify-content:center;flex-shrink:0"><svg width="12" height="12" viewBox="0 0 24 24" fill="white"><path d="M4 17l4-10h2l4 10h-2l-1-2.5H7L6 17H4zm3.6-4.5h2.8L9 8.5l-1.4 4z" /><path d="M14 17V7h2v4l3.5-4h2.5l-4 4.5L22 17h-2.5l-3-4-.5.5V17H14z" /></svg></span>';

        let step = 0;
        let playing = true;
        let timer = null;

        function escapeHtml(s) {
          return String(s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
        }
        function renderAssistantText(s) {
          return escapeHtml(s).replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>");
        }

        function chatRowHtml(e, ret) {
          if (e.kind === "user") {
            return `<div class="ev ev-user"><div class="bubble">${escapeHtml(e.text)}</div></div>`;
          }
          if (e.kind === "thinking") {
            return `<div class="ev ev-thinking"><span class="mcp-dot"></span><span class="mcp-dot d2"></span><span class="mcp-dot d3"></span><span style="margin-left:4px">${escapeHtml(e.text)}</span></div>`;
          }
          if (e.kind === "tool") {
            const retHtml = ret ? `<div class="ret"><span class="arr">↵</span><span>${escapeHtml(ret.text)}</span></div>` : "";
            return `<div class="ev ev-tool"><div class="head"><span class="led"></span><strong>mcp · ${escapeHtml(e.tool)}</strong></div><div class="args">${escapeHtml(e.args)}</div>${retHtml}</div>`;
          }
          if (e.kind === "assistant") {
            return `<div class="ev ev-assistant">${CLAUDE_MARK}<div class="body">${renderAssistantText(e.text)}</div></div>`;
          }
          return "";
        }

        function blockHtml(b) {
          if (b.kind === "h1") return `<div class="ev nb-h1">${escapeHtml(b.text)}</div>`;
          if (b.kind === "h2") return `<div class="ev nb-h2">${escapeHtml(b.text)}</div>`;
          if (b.kind === "callout") return `<div class="ev nb-callout"><span class="star">✦</span><span>${escapeHtml(b.text)}</span></div>`;
          if (b.kind === "li") return `<div class="ev nb-li"><span class="bullet">•</span><span>${escapeHtml(b.text)}</span></div>`;
          if (b.kind === "todo") return `<div class="ev nb-todo"><span class="box"></span><span>${escapeHtml(b.text)}</span></div>`;
          return "";
        }

        function render() {
          const events = SCRIPT.slice(0, step);
          const chatEvents = events.filter((e) => ["user", "assistant", "tool", "tool_ret", "thinking"].includes(e.kind));
          const rendered = [];
          for (let i = 0; i < chatEvents.length; i++) {
            const e = chatEvents[i];
            if (e.kind === "tool") {
              const ret = chatEvents[i + 1] && chatEvents[i + 1].kind === "tool_ret" ? chatEvents[i + 1] : null;
              rendered.push(chatRowHtml(e, ret));
              if (ret) i++;
            } else if (e.kind !== "tool_ret") {
              rendered.push(chatRowHtml(e));
            }
          }
          chatPane.innerHTML = rendered.join("");

          const noteAction = events.find((e) => e.kind === "note_action");
          const blocks = events.filter((e) => e.kind === "note_block").map((e) => e.block);

          if (noteAction) {
            noteCrumb.textContent = `업무 / 회의록 / ${noteAction.title}`;
            noteWriting.classList.add("on");
          } else {
            noteCrumb.textContent = L.idle;
            noteWriting.classList.remove("on");
          }
          if (blocks.length === 0 && !noteAction) {
            notePane.innerHTML = `<div class="nb-empty">${L.empty}</div>`;
          } else {
            const blockHtmls = blocks.map(blockHtml).join("");
            const cursor = noteAction && step < SCRIPT.length ? '<div class="nb-cursor"></div>' : "";
            notePane.innerHTML = blockHtmls + cursor;
          }

          chatPane.scrollTop = chatPane.scrollHeight;
          notePane.scrollTop = notePane.scrollHeight;
          progress.textContent = `${Math.min(step, SCRIPT.length)} / ${SCRIPT.length}`;
        }

        function schedule() {
          if (timer) {
            clearTimeout(timer);
            timer = null;
          }
          if (!playing) return;
          if (step >= SCRIPT.length) {
            timer = setTimeout(() => {
              step = 0;
              render();
              schedule();
            }, 3500);
            return;
          }
          const delay = SCRIPT[step].t;
          timer = setTimeout(() => {
            step++;
            render();
            schedule();
          }, delay);
        }

        function setPlaying(v) {
          playing = v;
          playBtn.innerHTML = v ? PAUSE_SVG : PLAY_SVG;
          playBtn.title = v ? "일시정지" : "재생";
          if (v) schedule();
          else if (timer) {
            clearTimeout(timer);
            timer = null;
          }
        }

        playBtn.addEventListener("click", () => setPlaying(!playing));
        restartBtn.addEventListener("click", () => {
          step = 0;
          render();
          if (!playing) setPlaying(true);
          else schedule();
        });

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                render();
                schedule();
                io.disconnect();
              }
            });
          },
          { threshold: 0.2 },
        );
        io.observe(root);
      })();
    </script>
  </body>
</html>
