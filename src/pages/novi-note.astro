      .final-cta::before {
        content: ""; position: absolute; inset: 0;
        opacity: 0.15;
        background-image: radial-gradient(white 1px, transparent 1px);
        background-size: 32px 32px;
        pointer-events: none;
      }
      .final-cta .inner { position: relative; }
      .final-cta .kicker-light {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.7);
        margin-bottom: 18px;
      }
      .final-cta h2 {
        margin: 0 auto 18px;
        font-family: var(--font-display);
        font-size: clamp(40px, 6vw, 72px);
        font-weight: 600;
        letter-spacing: -0.04em;
        line-height: 1;
        color: #fff;
        text-wrap: balance;
      }
      .final-cta p {
        margin: 0 auto 32px;
        max-width: 480px;
        font-size: 16px; line-height: 1.55;
        color: rgba(255, 255, 255, 0.85);
      }
      .final-cta .cta-btn {
        padding: 14px 24px;
        font-size: 15px; font-weight: 600;
        background: #fff;
        color: var(--accent);
        border: none; border-radius: 10px;
        display: inline-flex; align-items: center; gap: 8px;
        font-family: var(--font-body);
        letter-spacing: -0.01em;
        box-shadow: 0 12px 30px -8px rgba(0, 0, 0, 0.3);
        transition: transform 0.12s, box-shadow 0.12s;
      }
      .final-cta .cta-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 16px 36px -8px rgba(0, 0, 0, 0.35);
      }

      /* ===== Footer ===== */
      .foot {
        border-top: 1px solid var(--line);
        padding: 32px;
      }
      .foot-inner {
        max-width: var(--content-w); margin: 0 auto;
        display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
        font-family: var(--font-mono);
        font-size: 11px; color: var(--text-mute);
        letter-spacing: 0.04em;
      }
      .foot .links { display: flex; gap: 18px; }
      .foot .links a:hover { color: var(--text); }
      .foot .pad { flex: 1; }
      .mock-note-wrap {
        text-align: center;
        margin-top: 22px;
      }
      .mock-note {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 16px 9px 14px;
        border-radius: 999px;
        background: var(--accent-soft);
        border: 1px solid var(--accent-line);
        font-family: var(--font-body);
        font-size: 13.5px;
        color: var(--text);
        line-height: 1.4;
        letter-spacing: -0.005em;
      }
      .mock-note::before {
        content: "ⓘ";
        color: var(--accent);
        font-size: 15px;
        font-weight: 600;
        line-height: 1;
      }

      /* ===== Responsive ===== */
      @media (max-width: 980px) {
        .bento { grid-template-columns: repeat(2, 1fr); grid-auto-rows: auto; }
        .bento-card { grid-column: span 2 !important; grid-row: span 1 !important; min-height: 220px; }
        .bento-card.featured h3 { max-width: none; }
        .bento-card.featured p { max-width: none; }
        .steps { grid-template-columns: 1fr; }
        .steps .connector { display: none; }
        .demo-frame { grid-template-columns: 1fr; height: auto; }
        .demo-pane.chat { border-right: none; border-bottom: 1px solid var(--line); }
        .demo-body { max-height: 320px; overflow-y: auto; }
        .v3-showcase { padding-bottom: 24px; }
        .v3-cmd { margin-bottom: 16px; }
        .v3-todo { position: relative; right: auto; bottom: auto; margin: 24px auto 0; transform: rotate(0); width: 100%; max-width: 320px; }
      }
      @media (max-width: 640px) {
        .nav-inner { padding: 12px 16px; gap: 8px; }
        .hero { padding: 64px 20px 32px; }
        .section, .section.tight { padding-left: 20px; padding-right: 20px; }
        .final-cta { padding: 56px 24px; border-radius: 20px; }
        .compare-grid { font-size: 12px; min-width: 560px; }
        .compare-frame { overflow-x: auto; }
        .v3-notebook .body { padding: 20px 24px; }
      }
