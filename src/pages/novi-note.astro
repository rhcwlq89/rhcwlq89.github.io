---
import BaseHead from "../components/BaseHead.astro";
---

<!doctype html>
<html lang="ko" class="theme-dark">
  <head>
    <BaseHead
      title="Novi Note — 내 Mac의 AI 메모리 레이어"
      description="모든 노트는 내 Mac 안에. MCP로 Claude · Claude Code · Gemini · Codex가 노트를 읽고 씁니다. 구독 없음, 일회성 구매."
      lang="ko"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <style>
      /* ===== Theme tokens ===== */
      .theme-dark {
        --bg: #08070d;
        --bg-soft: #0e0c14;
        --panel: #13111a;
        --panel-hi: #1a1722;
        --line: rgba(255, 255, 255, 0.08);
        --line-hi: rgba(255, 255, 255, 0.14);
        --text: #f0eef7;
        --text-dim: rgba(240, 238, 247, 0.62);
        --text-mute: rgba(240, 238, 247, 0.42);
        --accent: #a78bfa;
        --accent-hi: #c4b5fd;
        --accent-soft: rgba(167, 139, 250, 0.14);
        --accent-line: rgba(167, 139, 250, 0.32);
        --success: #7ddca0;
        --grid: rgba(255, 255, 255, 0.04);
        --primary-fg: #0a0810;
        --hero-glow-1: rgba(167, 139, 250, 0.22);
        --hero-glow-2: rgba(196, 181, 253, 0.12);
      }
      .theme-light {
        --bg: #fbfaf7;
        --bg-soft: #f3f1ec;
        --panel: #ffffff;
        --panel-hi: #fbfaf7;
        --line: rgba(20, 16, 30, 0.1);
        --line-hi: rgba(20, 16, 30, 0.18);
        --text: #1a1626;
        --text-dim: rgba(26, 22, 38, 0.66);
        --text-mute: rgba(26, 22, 38, 0.46);
        --accent: #7c3aed;
        --accent-hi: #5b21b6;
        --accent-soft: rgba(124, 58, 237, 0.1);
        --accent-line: rgba(124, 58, 237, 0.32);
        --success: #16a34a;
        --grid: rgba(20, 16, 30, 0.04);
        --primary-fg: #ffffff;
        --hero-glow-1: rgba(124, 58, 237, 0.1);
        --hero-glow-2: rgba(167, 139, 250, 0.1);
      }

      /* ===== Reset ===== */
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body {
        background: var(--bg);
        color: var(--text);
        font-family: Inter, "SF Pro Text", -apple-system, sans-serif;
        font-feature-settings: "ss01", "cv11";
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        overflow-x: hidden;
        line-height: 1.55;
      }
      a { color: inherit; text-decoration: none; }
      button { font: inherit; cursor: pointer; }

      :root {
        --font-display: "Inter Tight", "SF Pro Display", -apple-system, Inter, sans-serif;
        --font-body: Inter, "SF Pro Text", -apple-system, sans-serif;
        --font-mono: "JetBrains Mono", "SF Mono", ui-monospace, monospace;
        --content-w: min(1500px, 92vw);
      }

      .page-bg {
        position: relative;
        background:
          radial-gradient(ellipse 60% 70% at 80% 0%, var(--hero-glow-1) 0%, transparent 60%),
          radial-gradient(ellipse 50% 50% at 10% 30%, var(--hero-glow-2) 0%, transparent 60%),
          var(--bg);
      }

      /* ===== Nav ===== */
      .nav {
        position: sticky; top: 0; z-index: 50;
        backdrop-filter: blur(20px) saturate(180%);
        -webkit-backdrop-filter: blur(20px) saturate(180%);
        background: color-mix(in srgb, var(--bg) 80%, transparent);
        border-bottom: 1px solid var(--line);
      }
      .nav-inner {
        max-width: var(--content-w); margin: 0 auto;
        padding: 14px 24px;
        display: flex; align-items: center; gap: 16px;
      }
      .brand-pill {
        display: flex; align-items: center; gap: 10px;
        padding: 6px 14px 6px 8px;
        border-radius: 999px;
        background: var(--panel);
        border: 1px solid var(--line);
      }
      .brand-pill .name {
        font-family: var(--font-display);
        font-size: 14px; font-weight: 600;
        letter-spacing: -0.02em;
      }
      .brand-pill .ver {
        font-family: var(--font-mono);
        font-size: 9.5px; color: var(--accent);
        padding: 2px 6px; border-radius: 4px;
        background: var(--accent-soft);
        letter-spacing: 0.04em;
      }
      .nav-spacer { flex: 1; }

      .toggles { display: flex; gap: 8px; align-items: center; }
      .toggle-pill {
        display: flex; padding: 3px;
        border-radius: 999px;
        background: var(--panel);
        border: 1px solid var(--line);
      }
      .toggle-pill button {
        padding: 5px 10px; border-radius: 999px;
        font-size: 11.5px; font-weight: 500;
        color: var(--text-mute);
        background: transparent;
        border: none;
        letter-spacing: 0.02em;
        transition: all 0.15s;
      }
      .toggle-pill button.active,
      .toggle-pill a.active {
        color: var(--text);
        background: var(--panel-hi);
        box-shadow: inset 0 0 0 1px var(--line);
      }
      .toggle-pill.lang a {
        display: inline-block;
        padding: 5px 10px; border-radius: 999px;
        font-size: 11.5px; font-weight: 500;
        color: var(--text-mute);
        text-decoration: none;
        letter-spacing: 0.02em;
        transition: all 0.15s;
      }
      .toggle-pill.lang a:hover { color: var(--text); }

      /* ===== Buttons ===== */
      .btn {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 9px 16px;
        font-family: var(--font-body);
        font-size: 13px; font-weight: 500;
        border-radius: 8px;
        border: 1px solid transparent;
        letter-spacing: -0.01em;
        transition: transform 0.12s, opacity 0.12s, background-color 0.12s;
      }
      .btn:active { transform: scale(0.98); }
      .btn.big { padding: 12px 20px; font-size: 14.5px; }
      .btn-primary {
        color: var(--primary-fg);
        background: var(--text);
        box-shadow:
          0 1px 0 var(--line-hi) inset,
          0 8px 24px -12px var(--text);
      }
      .btn-primary:hover { opacity: 0.92; }
      .btn-ghost {
        color: var(--text);
        background: transparent;
        border-color: var(--line);
      }
      .btn-ghost:hover { background: var(--panel); }

      /* ===== Kicker ===== */
      .kicker {
        display: inline-flex; align-items: center; gap: 8px;
        font-family: var(--font-mono);
        font-size: 11px; font-weight: 500;
        color: var(--accent);
        letter-spacing: 0.08em; text-transform: uppercase;
      }
      .kicker .bar { width: 14px; height: 1px; background: var(--accent); }
      .kicker.muted { color: var(--text-mute); }
      .kicker.muted .bar { background: var(--text-mute); }

      /* ===== Hero ===== */
      .hero {
        position: relative;
        max-width: var(--content-w);
        margin: 0 auto;
        padding: 88px 24px 40px;
        text-align: center;
      }
      .hero-chip {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 4px 4px 4px 14px; border-radius: 999px;
        background: var(--panel); border: 1px solid var(--line);
        font-size: 12px; color: var(--text-dim);
        margin-bottom: 28px;
      }
      .hero-chip .live {
        width: 6px; height: 6px; border-radius: 50%;
        background: var(--accent);
        box-shadow: 0 0 12px var(--accent);
      }
      .hero-chip .ver {
        padding: 4px 10px; border-radius: 999px;
        background: var(--accent-soft); color: var(--accent);
        font-family: var(--font-mono);
        font-size: 10.5px; letter-spacing: 0.04em;
      }
      .hero h1 {
        margin: 0 auto;
        max-width: 900px;
        font-family: var(--font-display);
        font-size: clamp(54px, 7.5vw, 104px);
        line-height: 0.96;
        letter-spacing: -0.045em;
        font-weight: 600;
        text-wrap: balance;
      }
      .hero h1 .grad {
        background: linear-gradient(120deg, var(--accent), var(--accent-hi), var(--accent));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }
      .hero-sub {
        margin: 28px auto 0;
        max-width: 600px;
        font-size: 17px; line-height: 1.55;
        color: var(--text-dim);
        text-wrap: pretty;
      }
      .hero-cta {
        display: inline-flex; gap: 10px;
        margin-top: 32px;
        flex-wrap: wrap; justify-content: center;
      }
      .meta-row {
        margin-top: 18px;
        display: flex; gap: 18px;
        justify-content: center; flex-wrap: wrap;
        font-family: var(--font-mono);
        font-size: 11px; color: var(--text-mute);
        letter-spacing: 0.02em;
      }
      .meta-row .sep { color: var(--line-hi); margin-left: 18px; }

      /* ===== V3 Showcase: layered cards ===== */
      .v3-showcase {
        position: relative;
        margin: 64px auto 0;
        max-width: 760px;
        padding-bottom: 60px;
        text-align: left;
      }
      .v3-notebook {
        position: relative;
        z-index: 1;
        width: 100%;
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 16px;
        box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.4);
        text-align: left;
        overflow: hidden;
      }
      .v3-notebook .bar {
        padding: 10px 14px;
        border-bottom: 1px solid var(--line);
        background: var(--panel-hi);
        display: flex; gap: 6px; align-items: center;
      }
      .v3-notebook .bar .traffic {
        width: 10px; height: 10px; border-radius: 50%;
      }
      .v3-notebook .bar .title {
        flex: 1; text-align: center;
        font-family: var(--font-mono);
        font-size: 10.5px;
        color: var(--text-mute);
      }
      .v3-notebook .body { padding: 32px 40px; }
      .v3-notebook .crumb {
        font-family: var(--font-mono);
        font-size: 11px; color: var(--text-mute);
        letter-spacing: 0.06em; text-transform: uppercase;
      }
      .v3-notebook h3 {
        font-family: var(--font-display);
        font-size: 28px; font-weight: 600;
        letter-spacing: -0.02em;
        margin: 8px 0 14px;
      }
      .v3-notebook .callout {
        padding: 8px 12px; border-radius: 8px;
        background: var(--accent-soft);
        border: 1px solid var(--accent-line);
        font-size: 12.5px; color: var(--text);
        margin-bottom: 16px;
        display: flex; gap: 8px; align-items: center;
      }
      .v3-notebook .callout .star { color: var(--accent); }
      .v3-notebook h4 {
        font-family: var(--font-display);
        font-size: 14px; font-weight: 600;
        margin: 0 0 6px;
      }
      .v3-notebook .li {
        display: flex; gap: 8px;
        font-size: 13px; padding: 2px 0;
        color: var(--text);
      }
      .v3-notebook .li .b { color: var(--text-mute); }

      .v3-cmd {
        position: relative;
        z-index: 2;
        width: min(540px, 100%);
        margin: 0 auto -36px;
        border-radius: 16px;
        background: var(--panel);
        border: 1px solid var(--line-hi);
        box-shadow:
          0 30px 80px -10px rgba(0, 0, 0, 0.55),
          0 0 60px -10px color-mix(in srgb, var(--accent) 53%, transparent);
        text-align: left;
        overflow: hidden;
      }
      .v3-cmd .head {
        display: flex; align-items: center; gap: 10px;
        padding: 12px 14px;
        border-bottom: 1px solid var(--line);
      }
      .v3-cmd .label {
        font-family: var(--font-mono);
        font-size: 11.5px; color: var(--text-mute);
      }
      .v3-cmd .kbd {
        font-family: var(--font-mono);
        font-size: 10px; color: var(--text-mute);
        padding: 2px 6px;
        border: 1px solid var(--line);
        border-radius: 4px;
      }
      .v3-cmd .placeholder {
        padding: 14px 14px 8px;
        font-size: 14px; color: var(--text-mute);
      }
      .v3-cmd .cursor {
        display: inline-block;
        width: 1.5px; height: 14px;
        background: var(--accent);
        margin-left: 4px;
        vertical-align: middle;
        animation: v3blink 1s infinite;
      }
      @keyframes v3blink { 50% { opacity: 0 } }
      .v3-cmd .results { padding: 4px 8px 10px; }
      .v3-cmd .item {
        display: flex; align-items: center; gap: 12px;
        padding: 10px;
        border-radius: 8px;
        margin-bottom: 2px;
        border: 1px solid transparent;
      }
      .v3-cmd .item.accent {
        background: var(--accent-soft);
        border-color: var(--accent-line);
      }
      .v3-cmd .item .ic {
        width: 28px; height: 28px; border-radius: 7px;
        background: var(--bg-soft);
        color: var(--text);
        display: flex; align-items: center; justify-content: center;
        font-family: var(--font-mono);
        font-size: 13px;
      }
      .v3-cmd .item.accent .ic {
        background: var(--accent); color: #fff;
      }
      .v3-cmd .item .body { flex: 1; }
      .v3-cmd .item .body .t {
        font-size: 13.5px; color: var(--text); font-weight: 500;
      }
      .v3-cmd .item .body .s {
        font-size: 11.5px; color: var(--text-mute);
        font-family: var(--font-mono);
      }

      .v3-todo {
        position: absolute;
        right: -12px; bottom: -10px;
        z-index: 3;
        width: 240px;
        padding: 16px;
        border-radius: 14px;
        background: var(--panel);
        border: 1px solid var(--line);
        box-shadow: 0 20px 50px -15px rgba(0, 0, 0, 0.4);
        text-align: left;
        transform: rotate(2deg);
      }
      .v3-todo .sub {
        font-family: var(--font-mono);
        font-size: 10px; color: var(--accent);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .v3-todo .title {
        font-family: var(--font-display);
        font-size: 15px; font-weight: 600;
        margin-top: 4px; margin-bottom: 8px;
      }
      .v3-todo .row {
        display: flex; align-items: center; gap: 8px;
        padding: 4px 0;
        font-size: 12.5px;
        color: var(--text-dim);
      }
      .v3-todo .row .box {
        width: 13px; height: 13px;
        border-radius: 3px;
        border: 1.4px solid var(--line-hi);
        display: flex; align-items: center; justify-content: center;
        color: #fff; font-size: 9px;
      }
      .v3-todo .row.done .box {
        background: var(--accent);
        border-color: var(--accent);
      }
      .v3-todo .row.done span:last-child {
        text-decoration: line-through;
        color: var(--text-mute);
      }

      /* ===== Section heading ===== */
      .section { max-width: var(--content-w); margin: 0 auto; padding: 80px 24px; }
      .section.tight { padding: 40px 24px 80px; }
      .section-head {
        text-align: center; margin-bottom: 40px;
      }
      .section-head h2 {
        margin: 14px auto 0;
        font-family: var(--font-display);
        font-size: clamp(34px, 4.5vw, 56px);
        font-weight: 600;
        letter-spacing: -0.035em;
        line-height: 1.05;
        text-wrap: balance;
        max-width: 700px;
      }
      .section-head p {
        margin: 12px auto 0;
        max-width: 580px;
        font-size: 15px; line-height: 1.55;
        color: var(--text-dim);
      }

      /* ===== Bento grid features ===== */
      .bento {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        grid-auto-rows: 180px;
        gap: 14px;
      }
      .bento-card {
        position: relative;
        overflow: hidden;
        padding: 24px;
        border-radius: 18px;
        background: var(--panel);
        border: 1px solid var(--line);
        color: var(--text);
        transition: transform 0.2s, border-color 0.2s;
        display: flex; flex-direction: column;
      }
      .bento-card:hover {
        transform: translateY(-2px);
        border-color: var(--accent-line);
      }
      .bento-card .tag {
        font-family: var(--font-mono);
        font-size: 10.5px;
        color: var(--text-mute);
        letter-spacing: 0.08em; text-transform: uppercase;
        margin-bottom: 8px;
      }
      .bento-card h3 {
        font-family: var(--font-display);
        font-size: 18px; font-weight: 600;
        letter-spacing: -0.02em;
        margin: 0 0 6px;
        line-height: 1.15;
      }
      .bento-card p {
        margin: 0;
        font-size: 13.5px; line-height: 1.5;
        color: var(--text-dim);
        flex: 1;
      }
      .bento-card.workday h3 { font-size: 26px; }
      .bento-card.workday .chips {
        display: flex; gap: 6px;
        margin-top: 14px; flex-wrap: wrap;
      }
      .bento-card.workday .chips span {
        font-family: var(--font-mono);
        font-size: 11px;
        padding: 4px 9px; border-radius: 999px;
        background: var(--bg-soft);
        color: var(--text-dim);
        border: 1px solid var(--line);
      }
      .bento-card.pricing .price-tag {
        margin-top: 14px;
        font-family: var(--font-display);
        font-size: 22px; font-weight: 600;
        letter-spacing: -0.02em;
        color: var(--accent);
      }
      .bento-card.pricing .price-tag .sub {
        font-size: 12px; color: var(--text-mute);
        font-family: var(--font-mono);
        font-weight: 400;
        letter-spacing: 0.02em;
        margin-left: 4px;
      }

      .bento-card.featured {
        grid-column: span 4; grid-row: span 2;
        padding: 32px;
        background: linear-gradient(135deg, var(--accent), var(--accent-hi));
        border: none;
        color: #fff;
      }
      .bento-card.featured:hover {
        transform: translateY(-2px);
      }
      .bento-card.featured .deco {
        position: absolute;
        right: -40px; top: -40px;
        opacity: 0.18;
        pointer-events: none;
      }
      .bento-card.featured .tag {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.18);
        color: #fff;
        text-transform: none;
        align-self: flex-start;
        margin-bottom: 12px;
      }
      .bento-card.featured h3 {
        font-size: 36px;
        color: #fff;
        max-width: 70%;
        margin-bottom: 12px;
      }
      .bento-card.featured p {
        font-size: 15px;
        color: rgba(255, 255, 255, 0.85);
        max-width: 70%;
      }
      .bento-card.featured .mcp-chips {
        display: flex; gap: 8px;
        margin-top: 18px;
        flex-wrap: wrap;
        position: relative;
      }
      .bento-card.featured .mcp-chips span {
        font-family: var(--font-mono);
        font-size: 11px;
        padding: 5px 10px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.16);
        color: #fff;
        letter-spacing: 0.02em;
      }
      .bento-card.span2 { grid-column: span 2; }
      .bento-card.span6 { grid-column: span 6; }

      /* ===== How it works (pill cards + connector) ===== */
      .steps {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
        position: relative;
      }
      .steps .connector {
        position: absolute;
        top: 38px; left: 12%; right: 12%;
        height: 2px;
        background: linear-gradient(90deg, transparent, var(--accent-line), var(--accent-line), transparent);
        z-index: 0;
      }
      .step-pill {
        position: relative; z-index: 1;
        padding: 28px 24px;
        border-radius: 18px;
        background: var(--panel);
        border: 1px solid var(--line);
      }
      .step-pill .num {
        width: 36px; height: 36px;
        border-radius: 12px;
        background: var(--accent);
        color: #fff;
        display: flex; align-items: center; justify-content: center;
        font-family: var(--font-mono);
        font-size: 13px; font-weight: 600;
        margin-bottom: 16px;
        box-shadow: 0 0 24px color-mix(in srgb, var(--accent) 40%, transparent);
      }
      .step-pill h3 {
        font-family: var(--font-display);
        font-size: 20px; font-weight: 600;
        letter-spacing: -0.02em;
        margin: 0 0 8px;
      }
      .step-pill p {
        margin: 0;
        font-size: 13.5px; line-height: 1.55;
        color: var(--text-dim);
      }
      .step-pill code {
        font-family: var(--font-mono);
        font-size: 12px;
        background: var(--bg-soft);
        padding: 1px 6px; border-radius: 4px;
        color: var(--text);
      }

      /* ===== MCP demo (gradient frame) ===== */
      .demo-frame-wrap {
        padding: 8px;
        border-radius: 22px;
        background: linear-gradient(135deg, var(--accent-line), transparent 50%, var(--accent-line));
        box-shadow:
          0 30px 80px -30px rgba(0, 0, 0, 0.5),
          0 0 80px -20px color-mix(in srgb, var(--accent) 40%, transparent);
      }
      .demo-frame {
        display: grid; grid-template-columns: 1fr 1fr; gap: 0;
        border-radius: 16px; overflow: hidden;
        background: var(--bg);
        height: 520px;
      }
      .demo-pane { display: flex; flex-direction: column; min-width: 0; }
      .demo-pane.chat { border-right: 1px solid var(--line); background: var(--bg-soft); }
      .demo-pane.note { background: var(--bg); }
      .demo-head {
        display: flex; align-items: center; gap: 8px;
        padding: 10px 14px;
        border-bottom: 1px solid var(--line);
        font-family: var(--font-mono);
        font-size: 10.5px; color: var(--text-mute); letter-spacing: 0.06em;
      }
      .demo-head .who { text-transform: uppercase; }
      .demo-head .crumb { color: var(--text-mute); margin-left: 4px; text-transform: none; }
      .demo-head .spacer { flex: 1; }
      .demo-head .live {
        color: var(--success);
        display: flex; align-items: center; gap: 4px;
      }
      .demo-head .live .led {
        width: 5px; height: 5px; border-radius: 50%;
        background: var(--success);
        box-shadow: 0 0 8px var(--success);
      }
      .demo-head .writing { color: var(--accent); display: none; align-items: center; gap: 4px; }
      .demo-head .writing.on { display: flex; }
      .demo-head .writing .led {
        width: 5px; height: 5px; border-radius: 50%;
        background: var(--accent);
        box-shadow: 0 0 8px var(--accent);
      }
      .demo-body {
        flex: 1; overflow: hidden;
        padding: 14px;
        display: flex; flex-direction: column; gap: 10px;
      }
      .demo-body.note-body { padding: 18px 18px 14px; gap: 4px; }

      .ev { animation: mcpFadeIn 0.35s cubic-bezier(0.2, 0.7, 0.3, 1) both; min-width: 0; }
      .ev-user { display: flex; justify-content: flex-end; }
      .ev-user .bubble {
        max-width: 82%;
        padding: 8px 12px; border-radius: 12px;
        background: var(--text); color: var(--primary-fg);
        font-size: 12.5px; line-height: 1.45;
      }
      .ev-thinking {
        display: flex; align-items: center; gap: 8px;
        color: var(--text-mute);
        font-size: 11.5px; padding: 2px 4px;
      }
      .ev-tool {
        display: flex; flex-direction: column;
        padding: 8px 10px; border-radius: 8px;
        background: var(--panel); border: 1px solid var(--line);
        font-family: var(--font-mono); font-size: 11px;
      }
      .ev-tool .head {
        display: flex; align-items: center; gap: 8px;
        color: var(--accent);
      }
      .ev-tool .head .led {
        display: inline-block; width: 5px; height: 5px; border-radius: 50%;
        background: var(--accent); box-shadow: 0 0 8px var(--accent);
      }
      .ev-tool .head strong { font-weight: 600; }
      .ev-tool .args {
        color: var(--text-dim);
        margin-top: 4px; padding-left: 13px;
        word-break: break-all;
      }
      .ev-tool .ret {
        margin-top: 6px; padding-left: 13px;
        color: var(--text-mute);
        display: flex; align-items: center; gap: 6px;
      }
      .ev-tool .ret .arr { color: var(--success); }
      .ev-assistant {
        display: flex; gap: 8px; align-items: flex-start;
      }
      .ev-assistant .body {
        flex: 1; padding: 8px 0;
        font-size: 12.5px; line-height: 1.5; color: var(--text);
      }
      .ev-assistant .body strong { color: var(--accent); font-weight: 600; }

      .nb-h1 {
        font-family: var(--font-display);
        font-size: 19px; font-weight: 600; letter-spacing: -0.02em;
        margin: 6px 0 4px;
      }
      .nb-h2 {
        font-family: var(--font-display);
        font-size: 14px; font-weight: 600; letter-spacing: -0.01em;
        margin: 10px 0 2px;
      }
      .nb-callout {
        padding: 8px 10px; border-radius: 6px;
        background: var(--accent-soft); border: 1px solid var(--accent-line);
        font-size: 11.5px; display: flex; gap: 8px;
      }
      .nb-callout .star { color: var(--accent); }
      .nb-li {
        display: flex; gap: 8px; padding: 1px 0;
        font-size: 12.5px; line-height: 1.45;
      }
      .nb-li .bullet { color: var(--text-mute); margin-top: 1px; }
      .nb-todo {
        display: flex; gap: 8px; align-items: center; padding: 1px 0;
        font-size: 12.5px;
      }
      .nb-todo .box {
        width: 13px; height: 13px; border-radius: 3px;
        border: 1.4px solid var(--line-hi); flex-shrink: 0;
      }
      .nb-empty {
        color: var(--text-mute); font-size: 11.5px;
        font-family: var(--font-mono); margin-top: 8px;
      }
      .nb-cursor {
        display: inline-block; width: 1.5px; height: 14px;
        background: var(--accent); margin-top: 4px;
        animation: mcpDot 1s infinite;
      }

      .demo-foot {
        display: flex; align-items: center; gap: 10px;
        padding: 10px 14px;
        border-top: 1px solid var(--line);
        font-family: var(--font-body);
        font-size: 12px; color: var(--text-mute);
      }
      .demo-foot button {
        width: 26px; height: 26px; border-radius: 6px;
        display: flex; align-items: center; justify-content: center;
        background: transparent; border: 1px solid var(--line); color: var(--text-dim);
      }
      .demo-foot .play {
        background: var(--accent); border: none; color: #fff;
      }
      .demo-foot .progress {
        flex: 1; text-align: right;
        font-family: var(--font-mono); font-size: 10.5px;
      }

      @keyframes mcpDot { 0%, 80%, 100% { opacity: 0.2 } 40% { opacity: 1 } }
      .mcp-dot {
        display: inline-block; width: 4px; height: 4px; border-radius: 50%;
        background: currentColor; animation: mcpDot 1.2s infinite ease-in-out;
      }
      .mcp-dot.d2 { animation-delay: 0.16s }
      .mcp-dot.d3 { animation-delay: 0.32s }
      @keyframes mcpFadeIn {
        from { opacity: 0; transform: translateY(4px) }
        to { opacity: 1; transform: none }
      }

      /* ===== Compare (full-accent header) ===== */
      .compare-frame {
        padding: 6px;
        border-radius: 22px;
        background: linear-gradient(135deg, var(--accent-line), var(--line) 60%);
      }
      .compare-grid {
        display: grid;
        grid-template-columns: 18fr 22fr 20fr 20fr 20fr;
        background: var(--panel);
        border-radius: 16px;
        overflow: hidden;
      }
      .cg-cell {
        padding: 18px 20px;
        font-family: var(--font-body);
        font-size: 15px;
        color: var(--text-dim);
        border-top: 1px solid var(--line);
        display: flex; align-items: center; justify-content: center;
        text-align: center;
        min-width: 0;
        word-break: keep-all;
      }
      .cg-cell:nth-child(-n+5) { border-top: none; }
      .cg-cell.cg-head {
        background: var(--panel-hi);
        font-family: var(--font-mono);
        font-size: 12.5px; font-weight: 500;
        color: var(--text-mute);
        letter-spacing: 0.06em; text-transform: uppercase;
      }
      .cg-cell.cg-first {
        background: var(--panel-hi);
        text-align: left;
        justify-content: flex-start;
        color: var(--text);
        font-weight: 500;
        font-size: 14.5px;
