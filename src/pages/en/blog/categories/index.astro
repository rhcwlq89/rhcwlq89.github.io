---
import { getCollection } from "astro:content";
import BaseHead from "../../../../components/BaseHead.astro";
import Footer from "../../../../components/Footer.astro";
import Header from "../../../../components/Header.astro";
import { SITE_TITLE } from "../../../../consts";
import { isPublished } from "../../../../utils/posts";
import { collectCategories } from "../../../../utils/categories";

const posts = (await getCollection("blog")).filter(
  (post) => post.id.startsWith("en/") && isPublished(post),
);
const categories = collectCategories(posts).filter((c) => c.posts.length > 0);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Categories | ${SITE_TITLE}`}
      description="All blog posts grouped into five categories."
      lang="en"
    />
    <style>
      main {
        width: 800px;
        max-width: calc(100% - 2em);
        margin: 2em auto;
      }
      h1 {
        margin-bottom: 0.5em;
      }
      .lead {
        color: rgb(var(--gray));
        margin-bottom: 2em;
      }
      .breadcrumb {
        font-size: 0.9em;
        margin-bottom: 1em;
        color: rgb(var(--gray));
      }
      .breadcrumb a {
        color: rgb(var(--gray-dark));
      }
      ul.category-grid {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.2em;
      }
      ul.category-grid li a {
        display: block;
        padding: 1.2em 1.4em;
        border-radius: 14px;
        background: rgba(var(--gray), 0.08);
        color: inherit;
        text-decoration: none;
        transition: background 0.2s;
      }
      ul.category-grid li a:hover {
        background: rgba(var(--accent), 0.15);
      }
      ul.category-grid h2 {
        margin: 0 0 0.3em;
        font-size: 1.1em;
        color: rgb(var(--black));
      }
      ul.category-grid li a:hover h2 {
        color: rgb(var(--accent));
      }
      .count {
        font-size: 0.9em;
        color: rgb(var(--gray));
      }
    </style>
  </head>
  <body>
    <Header lang="en" />
    <main>
      <nav class="breadcrumb" aria-label="breadcrumb">
        <a href="/en/">Home</a> &rsaquo; <a href="/en/blog/">Blog</a> &rsaquo; Categories
      </nav>
      <h1>Categories</h1>
      <p class="lead">{categories.length} categories, {posts.length} posts</p>
      <ul class="category-grid">
        {
          categories.map((c) => (
            <li>
              <a href={`/en/blog/categories/${c.slug}/`}>
                <h2>{c.en}</h2>
                <span class="count">{c.posts.length} posts</span>
              </a>
            </li>
          ))
        }
      </ul>
    </main>
    <Footer lang="en" />
  </body>
</html>
